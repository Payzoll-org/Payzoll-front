# tracked in git.

# Auth Service (AuthService/) - running locally on PORT=4000, no path prefix
# (routes are mounted at /api/auth directly, see AuthService/app.js)
VITE_AUTH_API_URL=http://localhost:4000


VITE_GATEWAY_API_URL=http://localhost:4000
