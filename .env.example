# Copy this file to .env and adjust for your local setup. .env itself is
# gitignored and should never be committed - only this example file is
# tracked in git.

# Auth Service (AuthService/) - running locally on PORT=4000, no path prefix
# (routes are mounted at /api/auth directly, see AuthService/app.js)
VITE_AUTH_API_URL=http://localhost:4000

# Agent Management / Agent Chat / Gateway services are not present in this
# workspace, so these are left as the coded fallback defaults from
# src/config/apiConfig.ts. Update once those services are available.
VITE_AGENT_MANAGEMENT_API_URL=http://localhost:3000/s2/agents
VITE_AGENT_CHAT_API_URL=http://localhost:3000/s3/agentchat
VITE_GATEWAY_API_URL=http://localhost:3000
